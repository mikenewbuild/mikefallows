---
import Base from '../layouts/Base.astro';
---

<Base title="Search">
  <link slot="head" href="/pagefind/pagefind-ui.css" rel="stylesheet" />

  <style is:global>
    .dark {
      --pagefind-ui-primary: #e7e5e4;
      --pagefind-ui-text: #e7e5e4;
      --pagefind-ui-background: #44403c;
      --pagefind-ui-border: #33302b;
      --pagefind-ui-tag: #e7e5e4;
    }
  </style>

  <h1 class="mb-12 font-medium">Search</h1>

  {
    import.meta.env.DEV ? (
      <p>The search index is built by Pagefind after a production build. Run <code>npm run build && npm run preview</code> to try it.</p>
    ) : (
      <>
        <div id="search" class="search"></div>
        <script is:inline src="/pagefind/pagefind-ui.js" onload="new PagefindUI({ element: '#search', showImages: false });"></script>
      </>
    )
  }
</Base>

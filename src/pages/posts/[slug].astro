---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import TagsList from '../../components/TagsList.astro';
import { getPosts, htmlDateString, isPublished, postUrl, readableDate, timeToRead, type Post } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, older: posts[index - 1], newer: posts[index + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
  older?: Post;
  newer?: Post;
}

const { post, older, newer } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description} templateClass="tmpl-post">
  <article data-pagefind-body>
    <div class="mx-auto max-w-3xl mb-4">
      <h1 class="text-2xl md:text-3xl max-w-xl font-medium" data-pagefind-meta="title">{post.data.title}</h1>
    </div>

    <div class="mx-auto max-w-3xl opacity-50" data-pagefind-ignore>
      <time datetime={htmlDateString(post.data.date)} class="font-medium">{readableDate(post.data.date)}</time>
      • {timeToRead(post.rendered?.html ?? '')}
      {!isPublished(post) && <span class="italic">(Draft)</span>}
    </div>

    <Prose>
      <Content />
    </Prose>

    <div class="leading-tight text-sm font-medium py-6">
      <TagsList tags={post.data.tags} />
    </div>
  </article>

  {
    (newer || older) && (
      <ul class="mt-4 text-sm font-medium border-t">
        {newer && (
          <li class="py-4">
            <span class="block opacity-70">Newer</span>
            <a class="hover:underline" href={postUrl(newer)}>{newer.data.title}</a>
          </li>
        )}
        {older && (
          <li class="py-4">
            <span class="block opacity-70">Older</span>
            <a class="hover:underline" href={postUrl(older)}>{older.data.title}</a>
          </li>
        )}
      </ul>
    )
  }
</Base>
